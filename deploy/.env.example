# 复制成 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交真实密钥

# MySQL root 密码（本地 dev 默认 root123，部署务必改）
MYSQL_ROOT_PASSWORD=root123

# RabbitMQ 账号
MQ_USERNAME=study
MQ_PASSWORD=study123

# JWT 签名密钥：至少 32 字节随机串，换掉默认值
# 生成方式：openssl rand -base64 48
JWT_SECRET=please-change-this-to-a-32-byte-random-string-2026

# DeepSeek Key：留空则不调用 AI，报告会自动走模板降级（status=2），功能不中断
DEEPSEEK_API_KEY=
